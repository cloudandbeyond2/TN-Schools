generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URI")
}

model User {
  id                String             @id @default(uuid())
  emisId            String?            @unique
  aadhaarHash       String?            @unique
  mobile            String?            @unique
  name              String
  email             String?            @unique
  passwordHash      String?
  role              Role               @default(STUDENT)
  isActive          Boolean            @default(true)
  schoolId          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  headmasterProfile HeadmasterProfile?
  notifications     Notification[]
  school            School?            @relation(fields: [schoolId], references: [id])
  student           Student?
  teacher           Teacher?

  @@index([schoolId])
}

model School {
  id                  String              @id @default(uuid())
  dise                String              @unique
  name                String
  address             String?
  district            String
  block               String
  pincode             String?
  schoolType          String              @default("Government")
  mediumOfInstruction String              @default("Tamil")
  classes             String[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  headmasterName      String?             @default("N/A")
  beoId               String?
  deoId               String?
  headmasterId        String?             @unique
  attendance          Attendance[]
  headmasterProfiles  HeadmasterProfile[]
  students            Student[]
  teachers            Teacher[]
  timetables          Timetable[]
  users               User[]

  @@index([beoId])
  @@index([deoId])
}

model Student {
  id                    String                @id @default(uuid())
  userId                String                @unique
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId              String
  class                 String
  section               String
  rollNumber            String?
  dob                   DateTime?
  gender                String?
  religion              String?
  caste                 String?
  parentName            String?
  parentMobile          String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  classRoomId           String?
  attendance            Attendance[]
  clubMembers           ClubMember[]
  healthReport          HealthReport?
  marks                 Mark[]
  parentLinks           ParentStudentLink[]
  portfolio             Portfolio?
  scholarships          Scholarship[]
  sportsProfile         SportsProfile?
  socialActivities      SocialActivity[]
  schoolPressActivities SchoolPressActivity[]
  watchlistEntry        WatchlistStudent?
  injuryReports         InjuryReport[]
  storyProgress         StudentStoryProgress[]
  school                School                @relation(fields: [schoolId], references: [id])

  @@index([classRoomId])
  @@index([schoolId])
}

model Teacher {
  id            String    @id @default(uuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId      String
  employeeId    String?   @unique
  subjects      String[]
  qualification String?
  joiningDate   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  address       String?
  dob           DateTime?
  gender        String?
  school        School    @relation(fields: [schoolId], references: [id])
}

model HeadmasterProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  schoolId    String
  employeeId  String?   @unique
  joiningDate DateTime?
  address     String?
  gender      String?
  dob         DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  school      School    @relation(fields: [schoolId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClassRoom {
  id            String   @id @default(uuid())
  schoolId      String
  teacherId     String?
  className     String
  section       String
  subject       String
  academicYear  String   @default("2024-25")
  roomNumber    String?
  schedule      String?
  totalStudents Int      @default(0)
  description   String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
}

model Mark {
  id           String   @id @default(uuid())
  studentId    String
  subject      String
  examType     String
  maxMarks     Int      @default(100)
  scored       Int
  grade        String?
  academicYear String   @default("2024-25")
  createdAt    DateTime @default(now())
  teacherId    String?
  student      Student  @relation(fields: [studentId], references: [id])

  @@index([studentId, subject, examType])
  @@index([teacherId])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  schoolId  String
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  method    String?
  createdAt DateTime         @default(now())
  school    School           @relation(fields: [schoolId], references: [id])
  student   Student          @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
  @@index([studentId, date])
  @@index([schoolId, date])
}

model Timetable {
  id        String   @id @default(uuid())
  schoolId  String
  class     String
  section   String
  dayOfWeek Int
  period    Int
  subject   String
  teacherId String?
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, class, section, dayOfWeek, period])
}

model Scholarship {
  id            String            @id @default(uuid())
  studentId     String
  scheme        String
  amount        Float
  status        ScholarshipStatus @default(PENDING)
  appliedDate   DateTime          @default(now())
  approvedDate  DateTime?
  disbursedDate DateTime?
  remarks       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  student       Student           @relation(fields: [studentId], references: [id])
}

model MidDayMeal {
  id               String   @id @default(uuid())
  schoolId         String
  date             DateTime
  studentsServed   Int
  menuItems        String[]
  stockUsedKg      Float?
  wastePercent     Float?
  supplierId       String?
  createdAt        DateTime @default(now())
  recordedByUserId String?

  @@unique([schoolId, date])
  @@index([schoolId, date])
  @@index([recordedByUserId])
}

model SchoolAsset {
  id               String    @id @default(uuid())
  schoolId         String
  category         String
  name             String
  quantity         Int
  condition        String    @default("Good")
  purchaseDate     DateTime?
  value            Float?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())
  recordedByUserId String?

  @@index([recordedByUserId])
}

model WatchlistStudent {
  id                  String   @id @default(uuid())
  name                String
  rollNumber          String
  class               String
  phone               String   @default("N/A")
  parentName          String   @default("N/A")
  district            String   @default("N/A")
  state               String   @default("N/A")
  city                String   @default("N/A")
  pincode             String   @default("N/A")
  risk                String   @default("Medium")
  issue               String   @default("High absenteeism + decline in math score averages below threshold")
  attendance          Float?
  lastScore           Float?
  notified            Boolean  @default(false)
  notificationMessage String?
  schoolId            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  studentId           String?  @unique
  student             Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([risk])
}

model HeadmasterStaff {
  id          String    @id @default(uuid())
  name        String
  emisId      String    @unique
  subject     String    @default("General")
  phone       String    @default("N/A")
  email       String?
  attendance  Float     @default(100)
  performance String    @default("Good")
  leaveUsed   Int       @default(0)
  password    String    @default("$2b$10$672zWrwIOxXoaL.Eh9iZhubuyoMM1/Gc3UJzBJTt45rBRN6ci/Tn2")
  schoolId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  address     String?
  dob         DateTime?
  gender      String?
  userId      String?   @unique

  @@index([schoolId])
}

model HeadmasterTempStaff {
  id        String   @id @default(uuid())
  name      String
  role      String
  agency    String   @default("Direct Contract")
  joined    String   @default("")
  phone     String   @default("N/A")
  email     String   @default("N/A")
  duration  String   @default("12 Months")
  salary    String   @default("N/A")
  status    String   @default("Active")
  password  String   @default("$2b$10$672zWrwIOxXoaL.Eh9iZhubuyoMM1/Gc3UJzBJTt45rBRN6ci/Tn2")
  schoolId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String?  @unique

  @@index([schoolId])
}

model HeadmasterParent {
  id             String               @id @default(uuid())
  name           String
  role           String
  phone          String
  email          String?
  studentName    String               @default("N/A")
  studentClass   String               @default("N/A")
  term           String
  password       String               @default("$2b$10$672zWrwIOxXoaL.Eh9iZhubuyoMM1/Gc3UJzBJTt45rBRN6ci/Tn2")
  schoolId       String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  userId         String?              @unique
  notifications  ParentNotification[]
  linkedStudents ParentStudentLink[]

  @@index([schoolId])
}

model ParentStudentLink {
  id        String           @id @default(uuid())
  parentId  String
  studentId String
  isPrimary Boolean          @default(false)
  createdAt DateTime         @default(now())
  parent    HeadmasterParent @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model ParentNotification {
  id        String           @id @default(uuid())
  parentId  String
  studentId String?
  type      String
  title     String
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  parent    HeadmasterParent @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([parentId, isRead])
}

model PTAMeeting {
  id              String   @id @default(uuid())
  schoolId        String?
  title           String
  description     String?
  meetingDate     DateTime
  venue           String   @default("School Auditorium")
  status          String   @default("Upcoming")
  agenda          String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@index([schoolId])
  @@index([schoolId, meetingDate])
  @@index([createdByUserId])
}

model HeadmasterAlumni {
  id           String   @id @default(uuid())
  name         String
  batch        String
  contribution String
  role         String
  phone        String
  email        String
  location     String
  value        String   @default("N/A")
  schoolId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([schoolId])
}

model StudyMaterial {
  id           String   @id @default(uuid())
  title        String
  category     String
  classSection String
  format       String
  size         String
  date         String   @default("Today")
  schoolId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  fileContent  String?
  teacherId    String?
  classRoomId  String?
  subject      String?

  @@index([schoolId])
  @@index([classRoomId])
  @@index([teacherId])
}

model Announcement {
  id           String   @id @default(uuid())
  title        String
  body         String
  target       String
  pinned       Boolean  @default(false)
  schoolId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  date         String   @default("Today")
  readReceipts String?  @default("0/40 read")
  sender       String
  senderId     String?

  @@index([schoolId])
}

model Homework {
  id          String               @id @default(uuid())
  title       String
  className   String
  dueDate     String
  status      String               @default("active")
  description String
  schoolId    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  teacherId   String?
  classRoomId String?
  subject     String?
  submissions HomeworkSubmission[]

  @@index([schoolId])
  @@index([classRoomId])
  @@index([teacherId])
}

model HomeworkSubmission {
  id         String   @id @default(uuid())
  homeworkId String
  rollNo     String
  name       String
  status     String
  score      String?  @default("—")
  date       String?  @default("—")
  answerText String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  studentId  String?
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
  @@index([studentId])
}

model EvaluationSubmission {
  id          String   @id @default(uuid())
  studentName String
  rollNo      String
  status      String   @default("pending")
  score       Float?
  totalMarks  Int      @default(10)
  submittedAt String
  ocrContent  Json
  schoolId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  studentId   String?

  @@index([schoolId])
}

model LabEquipment {
  id           String   @id @default(uuid())
  name         String
  classSection String
  status       String
  date         String
  safetyCheck  Boolean  @default(true)
  schoolId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  classRoomId  String?
  location     String?  @default("N/A")
  count        Int      @default(1)

  @@index([schoolId])
  @@index([classRoomId])
}

model LeaveRequest {
  id           String   @id @default(uuid())
  type         String
  duration     String
  reason       String
  status       String   @default("Pending")
  schoolId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  studentName  String   @default("Unknown")
  studentId    String?
  approvedById String?
  staffId      String?

  @@index([schoolId])
  @@index([approvedById])
  @@index([studentId])
}

model LessonPlan {
  id          String   @id @default(uuid())
  syllabus    String
  grade       String
  subject     String
  topic       String
  duration    String
  planData    Json
  schoolId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacherId   String?
  classRoomId String?

  @@index([schoolId])
  @@index([classRoomId])
  @@index([teacherId])
}

model Question {
  id         String   @id @default(uuid())
  grade      String
  subject    String
  topic      String
  difficulty String
  type       String
  text       String
  options    String[]
  answer     String
  marks      Int
  schoolId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teacherId  String?

  @@index([schoolId])
  @@index([teacherId])
}

model StudentBadge {
  id           String   @id @default(uuid())
  studentId    String
  studentName  String
  classSection String
  badge        String
  remark       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  awardedById  String?

  @@index([studentId])
  @@index([awardedById])
}

model Club {
  id          String       @id @default(uuid())
  schoolId    String?
  name        String
  category    String
  icon        String
  themeColor  String
  themeBg     String
  themeTagBg  String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  description String?      @default("Join us to build your portfolio, make lifelong friends, and develop critical leadership skills!")
  meetingTime String?      @default("TBD")
  sponsor     String?      @default("Faculty Sponsor")
  events      ClubEvent[]
  members     ClubMember[]

  @@index([schoolId])
}

model ClubMember {
  id        String   @id @default(uuid())
  clubId    String
  studentId String
  role      String   @default("Member")
  joinedAt  DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([clubId, studentId])
  @@index([clubId])
  @@index([studentId])
}

model ClubEvent {
  id         String   @id @default(uuid())
  clubId     String?
  schoolId   String?
  title      String
  eventDate  DateTime
  type       String
  icon       String
  themeColor String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  club       Club?    @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
  @@index([schoolId])
}

model Portfolio {
  id           String                 @id @default(uuid())
  studentId    String                 @unique
  bio          String?
  stream       String?                @default("General")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  student      Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  achievements PortfolioAchievement[]
  projects     PortfolioProject[]
  skills       PortfolioSkill[]
}

model PortfolioSkill {
  id          String    @id @default(uuid())
  portfolioId String
  name        String
  level       Int
  color       String
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model PortfolioProject {
  id          String    @id @default(uuid())
  portfolioId String
  title       String
  category    String
  date        String
  image       String
  tags        String[]
  description String
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model PortfolioAchievement {
  id          String    @id @default(uuid())
  portfolioId String
  title       String
  year        String
  icon        String
  color       String
  bg          String
  createdAt   DateTime  @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
}

model SportsProfile {
  id        String              @id @default(uuid())
  studentId String              @unique
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  events    SportsEvent[]
  stats     SportsFitnessStat[]
  logs      SportsHealthLog[]
  student   Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teams     SportsTeam[]
}

model SportsTeam {
  id              String        @id @default(uuid())
  sportsProfileId String
  name            String
  role            String
  icon            String
  color           String
  match           String
  date            String
  createdAt       DateTime      @default(now())
  sportsProfile   SportsProfile @relation(fields: [sportsProfileId], references: [id], onDelete: Cascade)

  @@index([sportsProfileId])
}

model SportsFitnessStat {
  id              String        @id @default(uuid())
  sportsProfileId String
  label           String
  value           String
  score           Int
  icon            String
  color           String
  createdAt       DateTime      @default(now())
  sportsProfile   SportsProfile @relation(fields: [sportsProfileId], references: [id], onDelete: Cascade)

  @@index([sportsProfileId])
}

model SportsEvent {
  id              String        @id @default(uuid())
  sportsProfileId String
  title           String
  date            String
  type            String
  icon            String
  createdAt       DateTime      @default(now())
  sportsProfile   SportsProfile @relation(fields: [sportsProfileId], references: [id], onDelete: Cascade)

  @@index([sportsProfileId])
}

model SportsHealthLog {
  id              String        @id @default(uuid())
  sportsProfileId String
  date            String
  activity        String
  duration        String
  calories        Int
  intensity       String
  createdAt       DateTime      @default(now())
  sportsProfile   SportsProfile @relation(fields: [sportsProfileId], references: [id], onDelete: Cascade)

  @@index([sportsProfileId])
}

model InjuryReport {
  id          String   @id @default(uuid())
  studentId   String
  studentName String
  className   String
  type        String
  severity    String
  description String
  status      String   @default("Pending")
  date        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CentralSubject {
  id        String        @id @default(uuid())
  class     String
  name      String
  icon      String?
  color     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @default(now()) @updatedAt
  units     CentralUnit[]

  @@unique([class, name])
}

model CentralUnit {
  id         String         @id @default(uuid())
  subjectId  String
  name       String
  unitNumber Int
  isApproved Boolean        @default(false)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @default(now()) @updatedAt
  topics     CentralTopic[]
  subject    CentralSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([subjectId, unitNumber])
}

model CentralTopic {
  id          String           @id @default(uuid())
  unitId      String
  name        String
  topicNumber Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt
  contents    CentralContent[]
  unit        CentralUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, topicNumber])
}

model CentralContent {
  id          String       @id @default(uuid())
  topicId     String
  contentType String
  title       String
  fileUrl     String?
  fileContent String?
  mcqs        Json?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  topic       CentralTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(uuid())
  parentId  String
  sender    String
  text      String
  schoolId  String?
  createdAt DateTime @default(now())

  @@index([parentId])
  @@index([schoolId])
}

model Celebration {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  description String?
  type        String   @default("EVENT")
  schoolId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([schoolId])
}

model HealthReport {
  id              String    @id @default(uuid())
  studentId       String    @unique
  height          Float?
  weight          Float?
  bloodGroup      String?
  vision          String?
  hearing         String?
  bmi             Float?
  dental          String?
  lastCheckupDate DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Beo {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @unique
  blockName String
  district  String
  deoId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([deoId])
}

model Commissioner {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId     String   @unique
  region     String?
  ministerId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())

  @@index([ministerId])
}

model ComputerEducation {
  id          String   @id
  title       String
  moduleType  String
  description String
  gradeLevel  String
  schoolId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([schoolId])
}

model ConferenceSession {
  id          String   @id
  schoolId    String
  schoolName  String
  className   String?
  section     String?
  scheduledAt DateTime
  scheduledBy String
  role        String
  status      String   @default("upcoming")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model CulturalEvent {
  id          String   @id
  title       String
  eventDate   DateTime
  location    String
  description String
  status      String   @default("Upcoming")
  schoolId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([schoolId])
}

model Deo {
  id             String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId         String   @unique
  districtName   String   @unique
  commissionerId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@index([commissionerId])
}

model Minister {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @unique
  portfolio String   @default("School Education")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model MinisterBudget {
  id        String   @id
  head      String
  category  String
  approved  Float
  released  Float
  utilized  Float
  fy        String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model MinisterDistrictPerformance {
  id         String   @id
  name       String   @unique
  schools    Int
  students   Int
  attendance Float
  pass10     Float
  pass12     Float
  dropout    Float
  infra      Int
  score      Int
  zone       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now())
}

model MinisterGrievance {
  id             String   @id
  petitioner     String
  district       String
  category       String
  filed          String
  status         String
  escalation     String
  ministerAction String
  createdAt      DateTime @default(now())
  updatedAt      DateTime
}

model MinisterInfrastructureProject {
  id         String   @id
  name       String
  district   String
  type       String
  budget     String
  completion Int
  deadline   String
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model MinisterKPI {
  id          String   @id
  label       String
  value       Float
  target      Float
  unit        String
  icon        String
  trend       String
  color       String
  bg          String
  lowerBetter Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model MinisterLiveAlert {
  id        String   @id
  type      String
  msg       String
  time      String
  createdAt DateTime @default(now())
}

model MinisterMedia {
  id        String   @id
  type      String
  title     String
  outlet    String
  date      String
  sentiment String
  reach     String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model MinisterPolicyBrief {
  id        String   @id
  title     String
  status    String
  priority  String
  impact    String
  districts Int
  since     String
  aiScore   Int
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model MinisterPrediction {
  id              String   @id
  category        String
  title           String
  prediction      String
  confidence      Int
  trend           String
  detail          String
  recommendations String[]
  color           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model MinisterScheme {
  id            String   @id
  name          String
  ministry      String
  budget        String
  beneficiaries String
  progress      Int
  phase         String
  status        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

model SocialActivity {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activityType String
  description  String?
  date         DateTime @default(now())
  points       Int      @default(0)
  status       String   @default("Pending Review")
  createdAt    DateTime @default(now())
  updatedAt    DateTime

  @@index([studentId])
}

model SchoolPressActivity {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId   String?
  description String
  photos      String[] @default([])
  isApproved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
}

model SuperAdmin {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  HEADMASTER
  BEO
  DEO
  COMMISSIONER
  MINISTER
  SUPERADMIN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum ScholarshipStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

model StoryBook {
  id            String                 @id @default(uuid())
  title         String
  author        String
  genre         String
  cover         String
  color         String
  language      String
  moral         String
  xpReward      Int                    @default(50)
  gradeLevel    String?                @default("6")

  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  chapters      StoryChapter[]
  progressLinks StudentStoryProgress[]

}

model StoryChapter {
  id            String      @id @default(uuid())
  storyBookId   String
  chapterNumber Int
  title         String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  storyBook     StoryBook   @relation(fields: [storyBookId], references: [id], onDelete: Cascade)
  pages         StoryPage[]

  @@index([storyBookId])
}

model StoryPage {
  id             String       @id @default(uuid())
  storyChapterId String
  pageNumber     Int
  contentEnglish String
  contentTamil   String
  illustration   String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  storyChapter   StoryChapter @relation(fields: [storyChapterId], references: [id], onDelete: Cascade)

  @@index([storyChapterId])
}

model StudentStoryProgress {
  id             String    @id @default(uuid())
  studentId      String
  storyBookId    String
  completed      Boolean   @default(false)
  progress       Int       @default(0)
  currentChapter Int       @default(1)
  currentPage    Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  storyBook      StoryBook @relation(fields: [storyBookId], references: [id], onDelete: Cascade)

  @@unique([studentId, storyBookId])
  @@index([studentId])
  @@index([storyBookId])
}

// ─── Digital Library ─────────────────────────────────────────────
model DigitalLibraryResource {
  id          String   @id @default(uuid())
  title       String
  type        String
  subject     String
  class       String
  size        String   @default("N/A")
  description String?
  tags        String[]
  fileUrl     String?
  uploadDate  DateTime @default(now())
  downloads   Int      @default(0)
  views       Int      @default(0)
  schoolId    String?
  teacherId   String?
  isActive    Boolean  @default(true)
  aiContent   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
}

// ─── Personal Guide ───────────────────────────────────────────────
model PersonalGuide {
  id             String   @id @default(uuid())
  studentName    String
  studentId      String?
  class          String
  section        String
  academicScore  Float    @default(0)
  attendance     Float    @default(0)
  strengths      String[]
  weaknesses     String[]
  goal           String   @default("Undecided")
  parentContact  String   @default("N/A")
  guidanceStatus String   @default("On Track")
  notes          String?
  lastMeeting    String   @default("")
  schoolId       String?
  teacherId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
}

// ─── NEET Preparation ─────────────────────────────────────────────
model NEETChapter {
  id             String   @id @default(uuid())
  subject        String
  chapter        String
  difficulty     String   @default("Medium")
  totalQuestions Int      @default(0)
  attempted      Int      @default(0)
  correct        Int      @default(0)
  status         String   @default("Pending")
  generatedQuestions Json?
  schoolId       String?
  teacherId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
}

model NEETMockTest {
  id            String   @id @default(uuid())
  title         String
  subject       String   @default("Full Syllabus")
  examDate      String   @default("")
  duration      String   @default("3 hrs 20 min")
  totalStudents Int      @default(0)
  avgScore      Int      @default(0)
  topScore      Int      @default(0)
  maxScore      Int      @default(720)
  schoolId      String?
  teacherId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
}

// ─── Competitive Exams ────────────────────────────────────────────
model CompetitiveExam {
  id                   String   @id @default(uuid())
  examName             String
  category             String
  conductedBy          String
  registrationDeadline String
  examDate             String
  status               String   @default("Upcoming")
  eligibility          String   @default("N/A")
  website              String?
  studentsEnrolled     Int      @default(0)
  studentsCleared      Int      @default(0)
  schoolId             String?
  teacherId            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([schoolId])
  @@index([teacherId])
}
